FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements-api.lock ./requirements-api.lock
RUN python -m pip install -r requirements-api.lock

COPY app/ ./app/
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.tts_main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
